# =============================================================================
# Biblioteca NEABI — variáveis de ambiente
#
# Copie para `.env` e preencha. Este arquivo é versionado e contém apenas
# exemplos: NUNCA escreva um segredo real aqui.
#
# Duas categorias de valor aparecem abaixo:
#
#   1. Segredos INTERNOS da aplicação — você mesmo gera, localmente.
#      Os comandos estão ao lado de cada variável.
#
#   2. Credenciais de SERVIÇOS EXTERNOS — só o provedor pode emitir.
#      Ficam vazias até você contratar/configurar o serviço. Uma string
#      inventada aqui não vira uma chave válida; apenas troca um erro claro
#      ("credencial ausente") por um confuso ("credencial rejeitada").
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL) — [EXTERNO em produção]
#
# O projeto usa PostgreSQL em todos os ambientes. Não há suporte a SQLite: o
# schema depende de tipos (enum, Int[], Json) e de garantias transacionais que
# o SQLite não oferece.
# -----------------------------------------------------------------------------
# Desenvolvimento local com o PostgreSQL embarcado (`npm run db:dev`):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/neabi?schema=public"
# Produção — exemplo com um Postgres gerenciado:
# DATABASE_URL="postgresql://usuario:senha@host:5432/neabi?schema=public&sslmode=require"

# Conexão SEM pooler, usada pelas migrações. Provedores como Neon e Supabase
# expõem um pooler que não aceita as instruções DDL do `prisma migrate`.
# Em desenvolvimento, repita o valor de DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54329/neabi?schema=public"

# Limite do pool. O cluster embarcado de desenvolvimento aceita poucas conexões.
DATABASE_POOL_MAX="10"

# -----------------------------------------------------------------------------
# Autenticação (Auth.js) — [INTERNO: gere o seu]
# -----------------------------------------------------------------------------
# Gere com:  openssl rand -base64 48
#   (ou)     node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# Mínimo de 32 caracteres. Trocar este valor invalida todas as sessões ativas.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# Armazenamento de arquivos (capas e PDFs)
# -----------------------------------------------------------------------------
# "local" grava em disco (desenvolvimento). "blob" usa o Vercel Blob — a opção
# para quem hospeda na Vercel, cujo sistema de arquivos é somente-leitura e
# faria o driver local falhar no upload. "s3" usa qualquer serviço compatível
# com S3 (Cloudflare R2, Amazon S3, Supabase Storage, MinIO).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage/uploads"
# Base pública dos arquivos enviados pelo painel. Os arquivos NÃO ficam em
# /public: são servidos por uma rota que verifica autorização antes de entregar
# o conteúdo — um PDF sem liberação nunca é acessível por URL direta.
NEXT_PUBLIC_STORAGE_BASE_URL="/api/arquivos"

# Necessário apenas quando STORAGE_DRIVER="blob" — [EXTERNO: emitido pela Vercel]
# Injetada automaticamente ao vincular uma store do Blob ao projeto:
#   vercel blob create-store <nome> --access private --yes
# A store é privada de propósito: todo arquivo sai pela rota que confere
# autorização, e nunca por URL direta.
# BLOB_READ_WRITE_TOKEN=""

# Necessário apenas quando STORAGE_DRIVER="s3" — [EXTERNO: emitido pelo provedor]
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://arquivos.exemplo.org"

# -----------------------------------------------------------------------------
# E-mail transacional (notificações de reserva)
# -----------------------------------------------------------------------------
# "console" apenas registra no log — padrão em desenvolvimento, não envia nada.
MAIL_DRIVER="console"
MAIL_FROM="Biblioteca NEABI <nao-responda@exemplo.org>"

# Necessário apenas quando MAIL_DRIVER="smtp" — [EXTERNO: dado pelo provedor]
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# -----------------------------------------------------------------------------
# Observabilidade e proteção
# -----------------------------------------------------------------------------
# debug | info | warn | error | silent
# Padrão: "debug" em desenvolvimento, "info" em produção, "silent" nos testes.
LOG_LEVEL="debug"

# Desligar só faz sentido em teste automatizado.
RATE_LIMIT_ENABLED="true"

# Autentica a rota de manutenção que expira reservas vencidas
# (POST /api/manutencao/expirar-reservas). Sem este valor a rota responde 503.
# Gere com:  openssl rand -hex 32
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Contas criadas pelo seed (`npm run db:seed`) — [INTERNO: gere as suas]
#
# Não há senha padrão no código: o seed falha se estas faltarem ou tiverem
# menos de 12 caracteres. Rodar o seed novamente realinha as senhas com o .env.
# Gere cada uma com:
#   node -e "console.log(require('node:crypto').randomBytes(12).toString('base64url'))"
# -----------------------------------------------------------------------------
SEED_ADMIN_NAME="Administração NEABI"
SEED_ADMIN_EMAIL="admin@neabi.local"
SEED_ADMIN_PASSWORD=""
SEED_EDITOR_PASSWORD=""
SEED_MEMBER_PASSWORD=""
