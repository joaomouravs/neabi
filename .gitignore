# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — todos ignorados, exceto o modelo sem segredos.
# A exceção precisa vir depois da regra: o Git aplica a última que casar.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Banco de desenvolvimento embarcado (PGlite)
/.pglite

# Cliente Prisma gerado
/src/generated

# Uploads locais do StorageProvider (fora de /public: acesso passa pela rota
# autorizada em /api/arquivos)
/storage

# Cluster PostgreSQL de desenvolvimento
/.postgres

# Playwright
/test-results
/playwright-report
/.playwright
.playwright/

# Vercel
# A regra de env fica só no bloco acima: repeti-la aqui anularia a exceção
# do .env.example, porque o Git aplica a última regra que casa.
.vercel

# Segredos gerados localmente
.prod-secrets.json
*-senha.txt
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*

# Backups e dumps do banco: contêm dados pessoais, mesmo cifrados.
# `gh run download` (README, "Restaurar") grava em ./backup.
/backup/
*.dump
*.dump.gpg
*.sql.gz
*.bak

# Logs
*.log
logs/

# Editores e sistema
.vscode/
.idea/
*.swp
Thumbs.db

# Instruções e configurações locais de assistentes de IA. São do ambiente de
# quem desenvolve, não do projeto: nada aqui é necessário para instalar,
# testar ou publicar. O `next dev` recria o AGENTS.md quando detecta um agente.
AGENTS.md
CLAUDE.md
GEMINI.md
.claude/
.agents/
.cursor/
.cursorrules
.windsurfrules
.aider*
.github/copilot-instructions.md
skills-lock.json
